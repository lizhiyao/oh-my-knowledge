{
  "schemaVersion": "omk.eval-sample-set/v3",
  "samples": [
    {
      "sampleId": "echo-green",
      "input": {
        "inputKind": "text",
        "text": "Return exactly this word: GREEN"
      },
      "evaluationContext": {
        "assertions": [
          {
            "type": "contains",
            "value": "GREEN"
          }
        ]
      }
    },
    {
      "sampleId": "echo-ready",
      "input": {
        "inputKind": "text",
        "text": "Return exactly this phrase: READY FOR EVAL"
      },
      "evaluationContext": {
        "assertions": [
          {
            "type": "contains_all",
            "values": [
              "READY",
              "EVAL"
            ]
          }
        ]
      }
    }
  ]
}
