{
  "schemaVersion": "omk.eval-sample-set/v3",
  "samples": [
    {
      "sampleId": "find-owner",
      "input": {
        "inputKind": "text",
        "text": "Which team owns the billing webhook, and what file proves it?"
      },
      "executionContext": {
        "cwd": "./workspace"
      },
      "evaluationContext": {
        "rubric": {
          "quality": {
            "criterion": "The answer should inspect the workspace and cite OWNERS.md or services/billing-webhook.md.",
            "weight": 1
          }
        },
        "assertions": [
          {
            "type": "contains_all",
            "values": [
              "Payments",
              "Platform",
              "billing-webhook"
            ]
          }
        ]
      },
      "annotations": {
        "capability": [
          "repo-navigation"
        ],
        "construct": "capability"
      }
    },
    {
      "sampleId": "summarize-runbook",
      "input": {
        "inputKind": "text",
        "text": "Summarize the deploy check for the billing webhook."
      },
      "executionContext": {
        "cwd": "./workspace"
      },
      "evaluationContext": {
        "rubric": {
          "quality": {
            "criterion": "The answer should mention signature verification and retry queue checks.",
            "weight": 1
          }
        },
        "assertions": [
          {
            "type": "contains_all",
            "values": [
              "signature",
              "retry"
            ]
          }
        ]
      },
      "annotations": {
        "capability": [
          "repo-navigation",
          "runbook-summary"
        ],
        "construct": "quality"
      }
    }
  ]
}
