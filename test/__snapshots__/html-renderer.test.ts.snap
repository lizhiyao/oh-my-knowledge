ll:var(--chart-2)"><title>v2 · 事实</title></circle><circle cx="218.2" cy="78.6" r="3" class="rad-dot" style="fill:var(--chart-2)"><title>v2 · 行为</title></circle><circle cx="215.3" cy="155.7" r="3" class="rad-dot" style="fill:var(--chart-2)"><title>v2 · 评委</title></circle><circle cx="150.0" cy="199.3" r="3" class="rad-dot" style="fill:var(--chart-2)"><title>v2 · 成本</title></circle><circle cx="80.8" cy="158.0" r="3" class="rad-dot" style="fill:var(--chart-2)"><title>v2 · 效率</title></circle><circle cx="114.5" cy="97.5" r="3" class="rad-dot rad-dot--na"><title>v2 · 稳定 未测量/无对照</title></circle></g><text x="150.0" y="18.0" text-anchor="middle" dominant-baseline="middle" class="rad-label">事实</text><text x="236.6" y="68.0" text-anchor="start" dominant-baseline="middle" class="rad-label">行为</text><text x="236.6" y="168.0" text-anchor="start" dominant-baseline="middle" class="rad-label">评委</text><text x="150.0" y="218.0" text-anchor="middle" dominant-baseline="middle" class="rad-label">成本</text><text x="63.4" y="168.0" text-anchor="end" dominant-baseline="middle" class="rad-label">效率</text><text x="63.4" y="68.0" text-anchor="end" dominant-baseline="middle" class="rad-label">稳定</text></svg><div class="rad-legend"><button type="button" class="rad-leg" data-idx="0" aria-pressed="true" style="--c:var(--chart-1)"><span class="rad-leg-dot"></span>v1</button><button type="button" class="rad-leg" data-idx="1" aria-pressed="true" style="--c:var(--chart-2)"><span class="rad-leg-dot"></span>v2</button><script>
