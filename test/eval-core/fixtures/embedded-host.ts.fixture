import {
  createEvaluationEngine,
  EXECUTION_FACTS_SCHEMA_VERSION,
  type EvaluationDefinition,
  type EvaluationEngineRuntime,
  type EvaluationEvent,
  type EvaluationRunResult,
  type Evaluator,
  type ExecutionFacts,
  type Executor,
  type MeasurementPolicy,
} from 'oh-my-knowledge';
import {
  createEvaluationEngine as createAdvancedEvaluationEngine,
  resolveEvaluationCoreJsonSchema,
  type ExecutionBundleSource,
} from 'oh-my-knowledge/eval-core';
import {
  createEvalSampleSetDocument,
  resolveEvalSampleJsonSchema,
  type EvalSampleSetDocument,
} from 'oh-my-knowledge/eval-samples';
import { projectCoreArtifactGraph } from 'oh-my-knowledge/projections';
import { createCoreStudioCatalog } from 'oh-my-knowledge/studio';
import {
  createObservationMcpServer,
  LOCAL_OBSERVATION_PRINCIPAL,
} from 'oh-my-knowledge/mcp';
import {
  apply as applyDshPlugin,
  name as dshPluginName,
} from 'oh-my-knowledge/dsh-plugin';

declare const runtime: EvaluationEngineRuntime;
declare const definition: EvaluationDefinition;
declare const policy: MeasurementPolicy;
declare const executor: Executor;
declare const evaluator: Evaluator;
declare const executionFacts: ExecutionFacts;

const executionFactsVersion: typeof EXECUTION_FACTS_SCHEMA_VERSION = executionFacts.schemaVersion;
void executionFactsVersion;

const sampleSet: EvalSampleSetDocument = createEvalSampleSetDocument([{
  sample_id: 'typescript-host',
  prompt: 'Verify the package contract.',
}]);
const sampleSchema: URL = resolveEvalSampleJsonSchema('eval-sample-set.schema.json');
void sampleSet;
void sampleSchema;
void projectCoreArtifactGraph;
void createCoreStudioCatalog;
void createObservationMcpServer;
void LOCAL_OBSERVATION_PRINCIPAL;
void applyDshPlugin;
void dshPluginName;

const engine = createEvaluationEngine({
  ...runtime,
  bindings: {
    ...runtime.bindings,
    resolveExecutor() {
      return {
        runtimeKind: 'executor',
        resolution: { identity: executor.identity, satisfiesVersionConstraint: true },
        port: executor,
      };
    },
    resolveEvaluator() {
      return {
        runtimeKind: 'evaluator',
        resolution: { identity: evaluator.identity, satisfiesVersionConstraint: true },
        port: evaluator,
      };
    },
  },
});
const run = engine.start(definition, { policy, runId: 'typescript-host' });

async function rootBoundary(): Promise<void> {
  const prepared = await engine.prepare(definition, policy);
  // @ts-expect-error 分阶段 API 只属于显式 eval-core 子路径。
  prepared.stages({ runId: 'root-must-stay-minimal' });
}

async function advancedBoundary(source: ExecutionBundleSource): Promise<void> {
  const advanced = createAdvancedEvaluationEngine(runtime);
  const prepared = await advanced.prepare(definition, policy);
  const stages = prepared.stages({ runId: 'typescript-advanced-host' });
  const evaluation = stages.evaluate({ execution: source });
  await evaluation.source;
  await stages.close();
  const schema: URL = resolveEvaluationCoreJsonSchema('execution-bundle.schema.json');
  void schema;
}

async function consume(): Promise<EvaluationRunResult> {
  for await (const event of run.events) {
    const serialized: EvaluationEvent = event;
    JSON.stringify(serialized);
  }
  return run.result;
}

void consume;
void rootBoundary;
void advancedBoundary;
