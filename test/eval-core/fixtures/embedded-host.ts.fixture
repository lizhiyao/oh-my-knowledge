import { z } from 'zod';
import {
  COMPARABILITY_ASSESSMENT_SCHEMA_VERSION,
  createEvaluationEngine,
  EXECUTION_FACTS_SCHEMA_VERSION,
  type EvaluationDefinition,
  type EvaluationEngineRuntime,
  type EvaluationEvent,
  type EvaluationRunResult,
  type ComparabilityRunIdentity,
  type Evaluator,
  type ExecutionFacts,
  type Executor,
  type MeasurementPolicy,
  resolveEvaluationCoreJsonSchema,
  type ExecutionBundleSource,
} from 'oh-my-knowledge/eval-core';
import {
  createEvaluationRuntime,
  createExactMatchDefinition,
  createInvokeExecutorIdentity,
  createJsonExecutorAdapter,
  createPairedComparisonDefinition,
  createMeasurementPolicy,
  createRubricJudgeKit,
  createRubricJudgeRegistration,
  type OmkLlmJudgeInvocationPort,
  type ExecutorConformanceProbeInput,
  assertExecutorConformance,
  runExecutorConformance,
  runEvaluation,
} from 'oh-my-knowledge/eval-runtime/advanced';
import {
  createRubricJudgeCriterion,
  createRubricJudgeEvaluator,
  createRubricJudgeEvaluatorDefinition,
  createRubricJudgeEvaluatorRegistration,
  createRubricJudgeInstrument,
  createRubricJudgeMetricDefinition,
  createRubricJudgeRuntimeConfig,
  type RuntimePortRegistration,
} from 'oh-my-knowledge/eval-runtime/advanced';
import {
  checkExecutor,
  EvaluationEventConsumptionError,
  evaluate,
} from 'oh-my-knowledge';
import {
  createEvalSampleSetDocument,
  resolveEvalSampleJsonSchema,
  type EvalSampleSetDocument,
} from 'oh-my-knowledge/eval-samples';
import { projectCoreArtifactGraph } from 'oh-my-knowledge/projections';
import { createCoreStudioCatalog } from 'oh-my-knowledge/studio';
import {
  createObservationMcpServer,
  LOCAL_OBSERVATION_PRINCIPAL,
} from 'oh-my-knowledge/mcp';
import {
  apply as applyDshPlugin,
  name as dshPluginName,
} from 'oh-my-knowledge/dsh-plugin';

declare const runtime: EvaluationEngineRuntime;
declare const definition: EvaluationDefinition;
declare const policy: MeasurementPolicy;
declare const executor: Executor;
declare const evaluator: Evaluator;
declare const executionFacts: ExecutionFacts;
declare const comparabilityRunIdentity: ComparabilityRunIdentity;

const executionFactsVersion: typeof EXECUTION_FACTS_SCHEMA_VERSION = executionFacts.schemaVersion;
const comparabilityAssessmentVersion: 'omk.comparability-assessment/v2' =
  COMPARABILITY_ASSESSMENT_SCHEMA_VERSION;
const comparabilityRunIdentityDigest: string = comparabilityRunIdentity.runIdentityDigest;
void executionFactsVersion;
void comparabilityAssessmentVersion;
void comparabilityRunIdentityDigest;

const sampleSet: EvalSampleSetDocument = createEvalSampleSetDocument([{
  sample_id: 'typescript-host',
  prompt: 'Verify the package contract.',
}]);
const sampleSchema: URL = resolveEvalSampleJsonSchema('eval-sample-set.schema.json');
void sampleSet;
void sampleSchema;
void projectCoreArtifactGraph;
void createCoreStudioCatalog;
void createObservationMcpServer;
void LOCAL_OBSERVATION_PRINCIPAL;
void applyDshPlugin;
void dshPluginName;

const publicRuntime = createEvaluationRuntime({
  executors: [{ port: executor }],
  evaluators: [{ port: evaluator }],
});
const publicDefinition = createExactMatchDefinition({
  datasetId: 'typescript-runtime-host',
  seed: 'explicit-seed',
  samples: [
    { sampleId: 'one', input: 'one', expected: 'one' },
    { sampleId: 'two', input: 'two', expected: 'two' },
  ],
  control: { targetId: 'control', executorId: executor.identity.implementationId },
  treatment: { targetId: 'treatment', executorId: executor.identity.implementationId },
});
const publicPolicy = createMeasurementPolicy();
const registration: RuntimePortRegistration<Executor> = { port: executor };
void publicRuntime;
void publicDefinition;
void publicPolicy;
void registration;

const canonicalEvaluation = evaluate({
  executor: {
    executorId: 'typescript-canonical/v1',
    version: '1.0.0',
    schemas: { input: z.string(), output: z.string() },
    async execute({ input, signal }) {
      signal.throwIfAborted();
      return { output: input };
    },
  },
  dataset: {
    datasetId: 'typescript-canonical-runtime',
    samples: [{ sampleId: 'one', input: 'question', expected: 'answer' }],
  },
  control: {
    variantId: 'baseline',
    artifact: { name: 'baseline', kind: 'baseline', source: 'baseline', content: null },
  },
  treatment: {
    variantId: 'prompt-v2',
    artifact: { name: 'prompt-v2', kind: 'prompt', source: 'inline', content: 'Answer.' },
  },
  evaluator: { evaluatorKind: 'exact-match' },
  experiment: { seed: 'typescript-seed' },
  policy: {},
  runId: 'typescript-canonical-runtime',
});
async function canonicalResultBoundary(): Promise<void> {
  const result = await canonicalEvaluation;
  const datasetId: string = result.definition.dataset.datasetId;
  const maxConcurrency: number = result.policy.execution.maxConcurrency;
  const runStatus: 'completed' | 'cancelled' | 'budget-exhausted' | 'failed' = result.status;
  void datasetId;
  void maxConcurrency;
  void runStatus;
}
void canonicalResultBoundary;

function canonicalEventErrorBoundary(error: unknown): void {
  if (!(error instanceof EvaluationEventConsumptionError) || error.runResult === undefined) return;
  const datasetId: string = error.runResult.definition.dataset.datasetId;
  const maxConcurrency: number = error.runResult.policy.execution.maxConcurrency;
  void datasetId;
  void maxConcurrency;
}
void canonicalEventErrorBoundary;
void checkExecutor;

const jsonIdentity = createInvokeExecutorIdentity({
  implementationId: 'test.typescript-json/v1',
  version: '1.0.0',
  determinism: 'deterministic',
  cancellation: 'cooperative',
  concurrency: { safety: 'parallel-safe' },
  seedControl: 'unsupported',
  telemetry: { trace: 'unsupported', usage: 'required' },
  fingerprintFacets: { revision: 'typescript-fixture' },
});
const jsonExecutor = createJsonExecutorAdapter({
  identity: jsonIdentity,
  inputParser: z.object({ question: z.string() }),
  targetConfigParser: z.object({ deployment: z.string() }),
  outputParser: z.object({ answer: z.string() }),
  outputClassification: 'public',
  async invoke({ input, targetConfig, signal }) {
    const question: string = input.question;
    const deployment: string = targetConfig.deployment;
    signal.throwIfAborted();
    // @ts-expect-error Parser-derived input does not expose undeclared fields.
    void input.missing;
    return {
      invocationStatus: 'completed',
      output: { answer: `${question}:${deployment}` },
      usage: { inputTokens: 1, outputTokens: 1, totalTokens: 2 },
    };
  },
});
createJsonExecutorAdapter({
  identity: jsonIdentity,
  inputParser: z.string(),
  targetConfigParser: z.undefined(),
  outputParser: z.string(),
  outputClassification: 'public',
  // @ts-expect-error Output must match the parser-derived string contract.
  async invoke() {
    return { invocationStatus: 'completed', output: 42 };
  },
});
createJsonExecutorAdapter({
  identity: jsonIdentity,
  inputParser: z.string(),
  targetConfigParser: z.undefined(),
  outputParser: z.string(),
  outputClassification: 'public',
  // @ts-expect-error A structured failure must include a stable errorCode.
  async invoke() {
    return { invocationStatus: 'failed', usage: { totalTokens: 1 } };
  },
});
const jsonRuntime = createEvaluationRuntime({
  executors: [{ port: jsonExecutor }],
  evaluators: [{ port: evaluator }],
});
void runEvaluation({
  runtime: jsonRuntime,
  definition: publicDefinition,
  policy: publicPolicy,
  runId: 'typed-json-runtime',
});
void jsonExecutor;

const genericDefinition = createPairedComparisonDefinition({
  datasetId: 'typescript-service-host',
  seed: 'explicit-service-seed',
  samples: publicDefinition.dataset.samples,
  control: { targetId: 'control', targetKind: 'rag', executorId: executor.identity.implementationId },
  treatment: {
    targetId: 'treatment',
    targetKind: 'rag',
    executorId: executor.identity.implementationId,
  },
  evaluator: publicDefinition.evaluators[0],
  metric: publicDefinition.metrics[0],
});
const conformanceInput: ExecutorConformanceProbeInput = {
  implementationId: executor.identity.implementationId,
  createExecutor: () => executor,
  success: { input: 'probe', expected: 'probe' },
  failure: { input: 'failure-probe', expectedErrorCode: 'expected-failure' },
  cancellation: { input: 'cancellation-probe' },
};
async function conformanceBoundary(): Promise<void> {
  const result = await runExecutorConformance(conformanceInput);
  assertExecutorConformance(result);
  const conformant: true = result.conformant;
  void conformant;
}
void genericDefinition;
void conformanceBoundary;

declare const judgeInvocation: OmkLlmJudgeInvocationPort;
const rubricInstrument = createRubricJudgeInstrument();
const rubricRuntime = createRubricJudgeRuntimeConfig({
  executorId: judgeInvocation.identity.implementationId,
  model: 'judge-model',
  instrument: rubricInstrument,
});
const rubricCriterion = createRubricJudgeCriterion({
  criterionId: 'quality',
  prompt: 'Answer.',
  rubric: 'Be correct.',
});
const rubricMetric = createRubricJudgeMetricDefinition('quality-score');
const rubricDefinition = createRubricJudgeEvaluatorDefinition({
  evaluatorId: 'quality-judge',
  metricId: rubricMetric.metricId,
  instrument: rubricInstrument,
  runtime: rubricRuntime,
  criterionPointer: '/quality',
});
const rubricEvaluator = createRubricJudgeEvaluator({
  instrument: rubricInstrument,
  runtime: rubricRuntime,
  invocation: judgeInvocation,
});
const rubricRegistration = createRubricJudgeEvaluatorRegistration([{
  evaluatorId: rubricDefinition.evaluatorId,
  instrument: rubricInstrument,
  runtime: rubricRuntime,
  invocation: judgeInvocation,
}]);
const rubricKit = createRubricJudgeKit({
  evaluatorId: 'quality-kit-judge',
  metricId: 'quality-kit-score',
  model: 'judge-model',
  invocation: judgeInvocation,
});
const rubricKitCriterion = rubricKit.createCriterion({
  criterionId: 'quality',
  prompt: 'Answer.',
  rubric: 'Be correct.',
});
// @ts-expect-error A Rubric criterion requires explicit rubric text.
rubricKit.createCriterion({ criterionId: 'invalid', prompt: 'Answer.' });
const rubricKitDefinition = createPairedComparisonDefinition({
  datasetId: 'typescript-rubric-kit',
  seed: 'typescript-rubric-kit-seed',
  samples: [{
    sampleId: 'one',
    input: 'question',
    evaluationContext: rubricKit.createEvaluationContext(rubricKitCriterion),
  }],
  control: { targetId: 'control', executorId: executor.identity.implementationId },
  treatment: { targetId: 'treatment', executorId: executor.identity.implementationId },
  evaluator: rubricKit.evaluatorDefinition,
  metric: rubricKit.metricDefinition,
});
const combinedRubricRegistration = createRubricJudgeRegistration([rubricKit]);
void rubricCriterion;
void rubricDefinition;
void rubricEvaluator;
void rubricRegistration;
void rubricKitDefinition;
void combinedRubricRegistration;

const engine = createEvaluationEngine({
  ...runtime,
  bindings: {
    ...runtime.bindings,
    resolveExecutor() {
      return {
        runtimeKind: 'executor',
        resolution: { identity: executor.identity, satisfiesVersionConstraint: true },
        port: executor,
      };
    },
    resolveEvaluator() {
      return {
        runtimeKind: 'evaluator',
        resolution: { identity: evaluator.identity, satisfiesVersionConstraint: true },
        port: evaluator,
      };
    },
  },
});
const run = engine.start(definition, { policy, runId: 'typescript-host' });

async function advancedBoundary(source: ExecutionBundleSource): Promise<void> {
  const advanced = createEvaluationEngine(runtime);
  const prepared = await advanced.prepare(definition, policy);
  const stages = prepared.stages({ runId: 'typescript-advanced-host' });
  const evaluation = stages.evaluate({ execution: source });
  await evaluation.source;
  await stages.close();
  const schema: URL = resolveEvaluationCoreJsonSchema('execution-bundle.schema.json');
  const comparabilitySchema: URL = resolveEvaluationCoreJsonSchema(
    'comparability-assessment.schema.json',
  );
  void schema;
  void comparabilitySchema;
}

async function consume(): Promise<EvaluationRunResult> {
  for await (const event of run.events) {
    const serialized: EvaluationEvent = event;
    JSON.stringify(serialized);
  }
  return run.result;
}

void consume;
void advancedBoundary;
