{
  "schemaVersion": "omk.eval-sample-set/v2",
  "samples": [
    {
      "sample_id": "env-001",
      "prompt": "只允许读取当前工作目录下的 ./skills/runtime-context-check.md 第一行，并原样输出第一行里的 runtime token。不要搜索整个仓库，不要使用 Glob。如果文件不存在，直接输出 NO_FILE_IN_CWD。",
      "rubric": {
        "groundedness": {
          "criterion": "是否直接基于当前 cwd 下的目标文件回答，而不是全仓搜索",
          "weight": 0.5
        },
        "runtime_context_sensitivity": {
          "criterion": "切换 cwd 后是否命中不同 runtime marker",
          "weight": 0.5
        }
      },
      "assertions": [
        {
          "type": "contains",
          "value": "OMK_RUNTIME",
          "weight": 1
        },
        {
          "type": "not_contains",
          "value": "NO_FILE_IN_CWD",
          "weight": 1
        },
        {
          "type": "turns_max",
          "value": 4,
          "weight": 0.5
        }
      ]
    },
    {
      "sample_id": "env-002",
      "prompt": "读取当前工作目录下的 ./skills/runtime-context-check.md，最终只输出 `RUNTIME:<第一行>`。第一行可能是随机 token，必须原样返回。不要解释。如果文件不存在，直接输出 NO_FILE_IN_CWD。",
      "rubric": {
        "traceability": {
          "criterion": "是否能从 trace 解释它直接读取了当前 cwd 下的目标文件",
          "weight": 0.5
        },
        "runtime_context_sensitivity": {
          "criterion": "切换 cwd 后是否输出不同 runtime marker",
          "weight": 0.5
        }
      },
      "assertions": [
        {
          "type": "contains",
          "value": "RUNTIME:OMK_RUNTIME",
          "weight": 1
        },
        {
          "type": "not_contains",
          "value": "NO_FILE_IN_CWD",
          "weight": 0.5
        },
        {
          "type": "turns_min",
          "value": 2,
          "weight": 0.5
        },
        {
          "type": "turns_max",
          "value": 4,
          "weight": 0.5
        }
      ]
    }
  ]
}
