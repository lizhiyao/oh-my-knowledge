{
  "schemaVersion": "omk.eval-sample-set/v2",
  "samples": [
    {
      "sample_id": "assertion-001",
      "prompt": "只允许读取当前工作目录下的 ./skills/runtime-context-check.md。不要搜索整个仓库，不要使用 Glob。如果文件存在，输出 `RUNTIME:<第一行>`；如果不存在，输出 `NO_FILE_IN_CWD`。第一行是随机 runtime token，必须原样返回。",
      "rubric": {
        "discrimination": {
          "criterion": "断言是否能把 baseline 与 runtime-context-only / artifact-injection 拉开",
          "weight": 0.5
        },
        "groundedness": {
          "criterion": "是否只基于当前 cwd 下的文件而不是全仓搜索",
          "weight": 0.5
        }
      },
      "assertions": [
        {
          "type": "tools_called",
          "values": [
            "Read"
          ],
          "weight": 1
        },
        {
          "type": "tool_output_contains",
          "value": "Read:OMK_RUNTIME_CODE_REVIEW_7F3D",
          "weight": 1
        },
        {
          "type": "turns_min",
          "value": 2,
          "weight": 0.5
        },
        {
          "type": "turns_max",
          "value": 4,
          "weight": 0.5
        }
      ]
    },
    {
      "sample_id": "assertion-002",
      "prompt": "读取当前工作目录下的 ./skills/runtime-context-check.md，并只输出一行结果。第一行是随机 runtime token。不要搜索整个仓库，不要解释。",
      "rubric": {
        "assertion_usefulness": {
          "criterion": "这些断言是否能把 artifact-injection 单独识别出来",
          "weight": 0.5
        },
        "efficiency": {
          "criterion": "是否避免无关搜索与提问",
          "weight": 0.5
        }
      },
      "assertions": [
        {
          "type": "tools_called",
          "values": [
            "Read",
            "Bash"
          ],
          "weight": 1
        },
        {
          "type": "tool_output_contains",
          "value": "Read:OMK_RUNTIME_CODE_REVIEW_7F3D",
          "weight": 1
        },
        {
          "type": "tool_input_contains",
          "value": "Bash:wc -l",
          "weight": 1
        },
        {
          "type": "turns_min",
          "value": 3,
          "weight": 0.5
        }
      ]
    }
  ]
