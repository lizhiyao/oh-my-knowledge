{
  "schemaVersion": "omk.eval-sample-set/v2",
  "samples": [
    {
      "sample_id": "code-review-sql-injection",
      "prompt": "请审查以下登录代码，指出主要风险并给出修复建议。",
      "context": "function authenticate(username, password) {\n  const query = `SELECT * FROM users WHERE name='${username}' AND pass='${password}'`;\n  return db.execute(query);\n}",
      "rubric": {
        "risk_identification": {
          "criterion": "是否准确识别核心安全风险",
          "weight": 0.3333333333333333
        },
        "remediation": {
          "criterion": "是否给出可执行的修复方案",
          "weight": 0.3333333333333333
        },
        "explanation": {
          "criterion": "是否解释风险为什么成立",
          "weight": 0.3333333333333333
        }
      },
      "assertions": [
        {
          "type": "contains",
          "value": "SQL",
          "weight": 1
        },
        {
          "type": "contains",
          "value": "injection",
          "weight": 1
        },
        {
          "type": "regex",
          "pattern": "parameterized|prepared|placeholder|bind",
          "flags": "i",
          "weight": 1
        },
        {
          "type": "not_contains",
          "value": "lgtm",
          "weight": 1
        }
      ],
      "capability": [
        "secure-code-review"
      ],
      "difficulty": "easy",
      "construct": "代码审查中的注入风险识别",
      "provenance": "human"
    },
    {
      "sample_id": "code-review-fetch-robustness",
      "prompt": "请审查以下网络请求代码，重点关注生产环境稳定性。",
      "context": "async function fetchData(url) {\n  const res = await fetch(url);\n  const data = await res.json();\n  return data;\n}",
      "rubric": {
        "risk_identification": {
          "criterion": "是否指出生产环境中的失败路径",
          "weight": 0.3333333333333333
        },
        "remediation": {
          "criterion": "是否给出完整的错误处理方案",
          "weight": 0.3333333333333333
        },
        "completeness": {
          "criterion": "是否覆盖网络、HTTP 状态码和解析失败",
          "weight": 0.3333333333333333
        }
      },
      "assertions": [
        {
          "type": "contains",
          "value": "handling",
          "weight": 1
        },
        {
          "type": "regex",
          "pattern": "try[\\s\\S]*catch|catch|exception|error",
          "flags": "i",
          "weight": 1
        },
        {
          "type": "regex",
          "pattern": "status|ok|HTTP",
          "flags": "i",
          "weight": 1
        },
        {
          "type": "regex",
          "pattern": "JSON|json",
          "flags": "i",
          "weight": 0.5
        }
      ],
      "capability": [
        "robustness-review"
      ],
      "difficulty": "medium",
      "construct": "异步网络代码的错误处理审查",
      "provenance": "human"
    },
    {
      "sample_id": "code-review-xss",
      "prompt": "请审查以下前端渲染代码，指出潜在安全问题。",
      "context": "function renderComment(comment) {\n  document.getElementById('output').innerHTML = '<p>' + comment + '</p>';\n}",
      "rubric": {
        "risk_identification": {
          "criterion": "是否准确识别 XSS",
          "weight": 0.3333333333333333
        },
        "remediation": {
          "criterion": "是否给出安全替代实现",
          "weight": 0.3333333333333333
        },
        "explanation": {
          "criterion": "是否说明用户输入与 DOM 注入的关系",
          "weight": 0.3333333333333333
        }
      },
      "assertions": [
        {
          "type": "contains",
          "value": "XSS",
          "weight": 1
        },
        {
          "type": "contains",
          "value": "innerHTML",
          "weight": 0.5
        },
        {
          "type": "regex",
          "pattern": "textContent|escape|sanitize|sanitizer",
          "flags": "i",
          "weight": 1
        },
        {
          "type": "not_contains",
          "value": "harmless",
          "weight": 0.5
        }
      ],
      "capability": [
        "frontend-security-review"
      ],
      "difficulty": "easy",
      "construct": "DOM XSS 风险识别",
      "provenance": "human"
    },
    {
      "sample_id": "code-review-authorization",
      "prompt": "请审查以下退款接口，关注权限和业务安全。",
      "context": "app.post('/refund', async (req, res) => {\n  const { orderId } = req.body;\n  const order = await db.orders.findById(orderId);\n  await payment.refund(order.paymentId);\n  res.json({ ok: true });\n});",
      "rubric": {
        "risk_identification": {
          "criterion": "是否识别越权退款风险",
          "weight": 0.3333333333333333
        },
        "business_logic": {
          "criterion": "是否覆盖订单归属、状态和幂等",
          "weight": 0.3333333333333333
        },
        "remediation": {
          "criterion": "是否给出服务端校验方案",
          "weight": 0.3333333333333333
        }
      },
      "assertions": [
        {
          "type": "regex",
          "pattern": "auth|authentication|authorization|permission",
          "flags": "i",
          "weight": 1
        },
        {
          "type": "regex",
          "pattern": "owner|ownership|user.*order|order.*user",
          "flags": "i",
          "weight": 1
        },
        {
          "type": "regex",
          "pattern": "status|refunded|idempotent|duplicate",
          "flags": "i",
          "weight": 1
        },
        {
          "type": "contains",
          "value": "refund",
          "weight": 0.5
        }
      ],
      "capability": [
        "business-security-review"
      ],
      "difficulty": "hard",
      "construct": "业务接口的权限和状态机审查",
      "provenance": "human"
    },
    {
      "sample_id": "code-review-secret-logging",
      "prompt": "请审查以下错误日志代码，关注隐私和运维风险。",
      "context": "async function callPartnerApi(user, token, payload) {\n  try {\n    return await partner.request(payload, token);\n  } catch (err) {\n    console.error('partner failed', { user, token, payload, err });\n    throw err;\n  }\n}",
      "rubric": {
        "risk_identification": {
          "criterion": "是否识别日志泄露敏感信息",
          "weight": 0.3333333333333333
        },
        "remediation": {
          "criterion": "是否给出脱敏和最小化日志策略",
          "weight": 0.3333333333333333
        },
        "operations": {
          "criterion": "是否考虑排障可观测性与安全之间的平衡",
          "weight": 0.3333333333333333
        }
      },
      "assertions": [
        {
          "type": "regex",
          "pattern": "token|secret|credential|sensitive",
          "flags": "i",
          "weight": 1
        },
        {
          "type": "regex",
          "pattern": "log|logging|console\\.error",
          "flags": "i",
          "weight": 1
        },
        {
          "type": "regex",
          "pattern": "mask|redact|minimize",
          "flags": "i",
          "weight": 1
        },
        {
          "type": "contains",
          "value": "leak",
          "weight": 0.5
        }
      ],
      "capability": [
        "privacy-and-ops-review"
      ],
      "difficulty": "medium",
      "construct": "日志中的敏感信息泄露审查",
      "provenance": "human"
    }
  ]
}
