      "input": {
        "inputKind": "text",
        "text": "请分类以下文本\n\n```\n苹果公司今日发布了新款 MacBook Pro，搭载 M4 芯片，性能较上一代提升 40%，售价 14999 元起。\n```"
      },
      "evaluationContext": {
        "rubric": {
          "quality": {
            "criterion": "应识别为科技类，提及产品发布相关关键词",
            "weight": 1
          }
        },
        "assertions": [
          {
            "type": "regex",
            "pattern": "technology|tech|digital",
            "flags": "i",
            "weight": 1
          },
          {
            "type": "regex",
            "pattern": "high|medium",
            "flags": "i",
            "weight": 0.5
          }
        ],
        "reference": "苹果公司今日发布了新款 MacBook Pro，搭载 M4 芯片，性能较上一代提升 40%，售价 14999 元起。"
      }
    },
