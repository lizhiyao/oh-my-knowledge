{
  "name": "omk-oclif-spike",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "oclif spike for omk CLI framework evaluation (issue #109) — not published, not part of main yarn workspace",
  "bin": {
    "omk-spike": "./bin/run.js"
  },
  "files": [
    "bin",
    "dist",
    "oclif.manifest.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "node bin/run.js",
    "dev": "node --import tsx bin/dev.js",
    "manifest": "oclif manifest",
    "readme": "oclif readme",
    "clean": "rm -rf dist oclif.manifest.json"
  },
  "dependencies": {
    "@oclif/core": "^4",
    "@oclif/plugin-autocomplete": "^3.2.49",
    "@oclif/plugin-not-found": "^3.2.85",
    "@oclif/plugin-warn-if-update-available": "^3.1.64"
  },
  "devDependencies": {
    "@types/node": "^22",
    "oclif": "^4",
    "tsx": "^4",
    "typescript": "^5"
  },
  "oclif": {
    "bin": "omk-spike",
    "commands": "./dist/commands",
    "dirname": "omk-spike",
    "helpClass": "./dist/help.js",
    "topicSeparator": " ",
    "plugins": [
      "@oclif/plugin-autocomplete",
      "@oclif/plugin-not-found",
      "@oclif/plugin-warn-if-update-available"
    ],
    "warn-if-update-available": {
      "timeoutInDays": 7,
      "message": "<%= config.name %> 有新版本可用,跑 <%= chalk.cyan('yarn upgrade ' + config.name) %>"
    },
    "exitCodes": {
      "default": 1,
      "failedFlagParsing": 2,
      "failedFlagValidation": 2,
      "invalidArgsSpec": 2,
      "nonExistentFlag": 2,
      "requiredArgs": 2,
      "unexpectedArgs": 2
    }
  }
}
