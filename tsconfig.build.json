{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    // No source/declaration maps in the published package: src/ is not shipped
    // (files: ["dist/"]), so maps would only point at absent .ts files — dead
    // weight for consumers. Keep declaration for the .d.ts that consumers use.
    "declarationMap": false,
    "sourceMap": false,
    "tsBuildInfoFile": "node_modules/.cache/omk/src.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist-scripts",
    "test"
  ]
}
