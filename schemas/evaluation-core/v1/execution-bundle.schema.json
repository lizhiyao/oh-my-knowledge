        "provenanceKind": {
          "enum": [
            "native",
            "imported",
            "replay",
            "derived"
          ],
          "type": "string"
        },
        "sourceId": {
          "$ref": "#/$defs/__schema6"
        },
        "trust": {
          "enum": [
            "verified",
            "declared",
            "untrusted",
            "unknown"
