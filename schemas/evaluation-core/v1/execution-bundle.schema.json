    "__schema19": {
      "additionalProperties": false,
      "properties": {
        "cacheKeyDigest": {
          "$ref": "#/$defs/__schema2"
        },
        "cacheStatus": {
          "enum": [
            "not-used",
            "miss",
            "replay",
            "transparent-hit"
