        "sourceRecordDigest": {
          "$ref": "#/$defs/__schema2"
        }
      },
      "required": [
        "cacheStatus"
      ],
      "type": "object"
    },
    "__schema2": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "__schema20": {
      "additionalProperties": {
