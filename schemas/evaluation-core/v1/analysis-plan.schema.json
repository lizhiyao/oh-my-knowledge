{
  "$defs": {
    "__schema0": {
      "const": "omk.analysis-plan/v1",
      "type": "string"
    },
    "__schema1": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "__schema10": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "items": {
            "$ref": "#/$defs/__schema10"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/__schema10"
          },
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        }
      ]
    },
    "__schema11": {
      "additionalProperties": false,
      "properties": {
        "randomizationSlots": {
          "items": {
            "$ref": "#/$defs/__schema13"
          },
          "minItems": 1,
          "type": "array"
        },
        "sampling": {
          "additionalProperties": false,
          "properties": {
            "clusterKey": {
              "$ref": "#/$defs/__schema12"
            },
            "estimatorId": {
              "$ref": "#/$defs/__schema3"
            },
            "experimentalUnit": {
              "enum": [
                "sample",
                "run",
                "cluster"
              ],
              "type": "string"
            },
            "pairingKey": {
              "$ref": "#/$defs/__schema12"
            },
            "repeatedMeasures": {
              "type": "boolean"
            },
            "resamplingUnit": {
              "enum": [
                "sample",
                "paired-block",
                "cluster",
                "run"
              ],
              "type": "string"
            },
            "seedCoupling": {
              "enum": [
                "shared-within-block",
                "independent-by-target",
                "uncontrolled"
              ],
              "type": "string"
            },
            "stratumKey": {
              "$ref": "#/$defs/__schema12"
            }
          },
          "required": [
            "experimentalUnit",
            "repeatedMeasures",
            "resamplingUnit",
            "estimatorId",
            "seedCoupling"
          ],
          "type": "object"
        },
        "scheduling": {
          "additionalProperties": false,
          "properties": {
            "blockSize": {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            "schedulingKind": {
              "enum": [
                "sequential",
                "interleaved",
                "randomized-block"
              ],
              "type": "string"
            }
          },
          "required": [
            "schedulingKind"
          ],
          "type": "object"
        },
        "seed": {
          "$ref": "#/$defs/__schema4"
        },
        "trials": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        }
      },
      "required": [
        "trials",
        "seed",
        "sampling",
        "scheduling",
        "randomizationSlots"
      ],
      "type": "object"
    },
    "__schema12": {
      "pattern": "^(?:\\/(?:[^~/]|~[01])*)*$",
      "type": "string"
    },
    "__schema13": {
      "additionalProperties": false,
      "properties": {
        "randomizationSlotId": {
          "$ref": "#/$defs/__schema3"
        },
        "targetId": {
          "$ref": "#/$defs/__schema3"
        }
      },
      "required": [
        "targetId",
        "randomizationSlotId"
      ],
      "type": "object"
    },
    "__schema14": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "comparisonId": {
            "$ref": "#/$defs/__schema3"
          },
          "controlTargetId": {
            "$ref": "#/$defs/__schema3"
          },
          "metricIds": {
            "items": {
              "$ref": "#/$defs/__schema3"
            },
            "minItems": 1,
            "type": "array"
          },
          "treatmentTargetIds": {
            "items": {
              "$ref": "#/$defs/__schema3"
            },
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "comparisonId",
          "controlTargetId",
          "treatmentTargetIds",
          "metricIds"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "__schema15": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "identity": {
            "additionalProperties": false,
            "properties": {
              "assuranceLevel": {
                "enum": [
                  "verified",
                  "declared",
                  "unknown"
                ],
                "type": "string"
              },
              "capabilities": {
                "$ref": "#/$defs/__schema10"
              },
              "fingerprint": {
                "$ref": "#/$defs/__schema4"
              },
              "fingerprintBasis": {
                "enum": [
                  "content-derived",
                  "environment-derived",
                  "self-reported",
                  "opaque"
                ],
                "type": "string"
              },
              "implementationFacets": {
                "$ref": "#/$defs/__schema10"
              },
              "implementationId": {
                "$ref": "#/$defs/__schema3"
              },
              "provenanceFacets": {
                "$ref": "#/$defs/__schema10"
              },
              "version": {
                "$ref": "#/$defs/__schema4"
              }
            },
            "required": [
              "implementationId",
              "fingerprint",
              "fingerprintBasis",
              "assuranceLevel",
              "capabilities"
            ],
            "type": "object"
          },
          "referenceId": {
            "$ref": "#/$defs/__schema3"
          },
          "runtimeKind": {
            "enum": [
              "executor",
              "evaluator",
              "analysis-node",
              "missing-policy",
              "decision-policy"
            ],
            "type": "string"
          }
        },
        "required": [
          "runtimeKind",
          "referenceId",
          "identity"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "__schema16": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/$defs/__schema10"
          },
          "schemaDigest": {
            "$ref": "#/$defs/__schema1"
          },
          "schemaUri": {
            "$ref": "#/$defs/__schema17"
          }
        },
        "required": [
          "schemaUri",
          "schemaDigest",
          "data"
        ],
        "type": "object"
      },
      "propertyNames": {
        "$ref": "#/$defs/__schema17"
      },
      "type": "object"
    },
    "__schema17": {
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:",
      "type": "string"
    },
    "__schema2": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "direction": {
            "enum": [
              "higher-is-better",
              "lower-is-better",
              "target-is-best"
            ],
            "type": "string"
          },
          "metricId": {
            "$ref": "#/$defs/__schema3"
          },
          "missingPolicyId": {
            "$ref": "#/$defs/__schema3"
          },
          "scale": {
            "additionalProperties": false,
            "properties": {
              "max": {
                "type": "number"
              },
              "min": {
                "type": "number"
              },
              "target": {
                "type": "number"
              }
            },
            "type": "object"
          },
          "scope": {
            "enum": [
              "sample",
              "target",
              "comparison",
              "run"
            ],
            "type": "string"
          },
          "unit": {
            "$ref": "#/$defs/__schema4"
          },
          "valueType": {
            "enum": [
              "numeric",
              "boolean",
              "categorical",
              "text",
              "ranking"
            ],
            "type": "string"
          }
        },
        "required": [
          "metricId",
          "valueType",
          "scope",
          "missingPolicyId"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "__schema3": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "__schema4": {
      "minLength": 1,
      "type": "string"
    },
    "__schema5": {
      "additionalProperties": false,
      "properties": {
        "analysisMode": {
          "enum": [
            "preregistered",
            "exploratory"
          ],
          "type": "string"
        },
        "nodes": {
          "items": {
            "oneOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "analysisNodeKind": {
                    "const": "reducer",
                    "type": "string"
                  },
                  "implementationId": {
                    "$ref": "#/$defs/__schema3"
                  },
                  "inputs": {
                    "$ref": "#/$defs/__schema7"
                  },
                  "nodeId": {
                    "$ref": "#/$defs/__schema3"
                  },
                  "outputResultId": {
                    "$ref": "#/$defs/__schema3"
                  },
                  "parameters": {
                    "$ref": "#/$defs/__schema9"
                  },
                  "versionConstraint": {
                    "$ref": "#/$defs/__schema6"
                  }
                },
                "required": [
                  "nodeId",
                  "implementationId",
                  "inputs",
                  "outputResultId",
                  "analysisNodeKind"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "analysisNodeKind": {
                    "const": "estimator",
                    "type": "string"
                  },
                  "implementationId": {
                    "$ref": "#/$defs/__schema3"
                  },
                  "inputs": {
                    "$ref": "#/$defs/__schema7"
                  },
                  "nodeId": {
                    "$ref": "#/$defs/__schema3"
                  },
                  "outputResultId": {
                    "$ref": "#/$defs/__schema3"
                  },
                  "parameters": {
                    "$ref": "#/$defs/__schema9"
                  },
                  "versionConstraint": {
                    "$ref": "#/$defs/__schema6"
                  }
                },
                "required": [
                  "nodeId",
                  "implementationId",
                  "inputs",
                  "outputResultId",
                  "analysisNodeKind"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "analysisNodeKind": {
                    "const": "correction",
                    "type": "string"
                  },
                  "implementationId": {
                    "$ref": "#/$defs/__schema3"
                  },
                  "inputs": {
                    "$ref": "#/$defs/__schema7"
                  },
                  "nodeId": {
                    "$ref": "#/$defs/__schema3"
                  },
                  "outputResultId": {
                    "$ref": "#/$defs/__schema3"
                  },
                  "parameters": {
                    "$ref": "#/$defs/__schema9"
                  },
                  "versionConstraint": {
                    "$ref": "#/$defs/__schema6"
                  }
                },
                "required": [
                  "nodeId",
                  "implementationId",
                  "inputs",
                  "outputResultId",
                  "analysisNodeKind"
                ],
                "type": "object"
              }
            ]
          },
          "type": "array"
        }
      },
      "required": [
        "analysisMode",
        "nodes"
      ],
      "type": "object"
    },
    "__schema6": {
      "$ref": "#/$defs/__schema4"
    },
    "__schema7": {
      "items": {
        "$ref": "#/$defs/__schema8"
      },
      "minItems": 1,
      "type": "array"
    },
    "__schema8": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "inputKind": {
              "const": "metric-observations",
              "type": "string"
            },
            "referenceId": {
              "$ref": "#/$defs/__schema3"
            }
          },
          "required": [
            "inputKind",
            "referenceId"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "inputKind": {
              "const": "analysis-result",
              "type": "string"
            },
            "referenceId": {
              "$ref": "#/$defs/__schema3"
            }
          },
          "required": [
            "inputKind",
            "referenceId"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "inputKind": {
              "const": "comparison",
              "type": "string"
            },
            "metricId": {
              "$ref": "#/$defs/__schema3"
            },
            "referenceId": {
              "$ref": "#/$defs/__schema3"
            },
            "treatmentTargetId": {
              "$ref": "#/$defs/__schema3"
            }
          },
          "required": [
            "inputKind",
            "referenceId",
            "treatmentTargetId",
            "metricId"
          ],
          "type": "object"
        }
      ]
    },
    "__schema9": {
      "$ref": "#/$defs/__schema10"
    }
  },
  "$id": "https://raw.githubusercontent.com/lizhiyao/oh-my-knowledge/main/schemas/evaluation-core/v1/analysis-plan.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "analysisGraph": {
      "$ref": "#/$defs/__schema5"
    },
    "analysisPlanDigest": {
      "$ref": "#/$defs/__schema1"
    },
    "comparisons": {
      "$ref": "#/$defs/__schema14"
    },
    "evaluationPlanDigest": {
      "$ref": "#/$defs/__schema1"
    },
    "experiment": {
      "$ref": "#/$defs/__schema11"
    },
    "extensions": {
      "$ref": "#/$defs/__schema16"
    },
    "metrics": {
      "$ref": "#/$defs/__schema2"
    },
    "runtimes": {
      "$ref": "#/$defs/__schema15"
    },
    "schemaVersion": {
      "$ref": "#/$defs/__schema0"
    }
  },
  "required": [
    "schemaVersion",
    "evaluationPlanDigest",
    "metrics",
    "analysisGraph",
    "experiment",
    "comparisons",
    "runtimes",
    "analysisPlanDigest"
  ],
  "title": "OMK Analysis Plan v1",
  "type": "object"
}
