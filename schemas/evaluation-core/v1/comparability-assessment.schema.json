        "datasetRevisionDigest",
        "executionInputDigest",
        "evaluationInputDigest",
        "randomizationDesignDigest",
        "executionPlanDigest",
        "evaluationPlanDigest",
        "analysisPlanDigest",
        "decisionPlanDigest",
        "runContractDigest"
