    "policyDigest",
    "designMode",
    "comparisonScope",
    "left",
    "right",
    "designStatus",
    "evidenceQualificationStatus",
    "comparabilityStatus",
    "reasons",
    "assessmentDigest"
  ],
  "type": "object"
}
