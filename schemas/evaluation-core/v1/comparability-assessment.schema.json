        "decisionPlanDigest": {
          "$ref": "#/$defs/__schema1"
        },
        "evaluationInputDigest": {
          "$ref": "#/$defs/__schema1"
        },
        "evaluationPlanDigest": {
          "$ref": "#/$defs/__schema1"
        },
        "executionInputDigest": {
          "$ref": "#/$defs/__schema1"
        },
        "executionPlanDigest": {
          "$ref": "#/$defs/__schema1"
        },
        "randomizationDesignDigest": {
          "$ref": "#/$defs/__schema1"
        },
        "runContractDigest": {
          "$ref": "#/$defs/__schema1"
        }
