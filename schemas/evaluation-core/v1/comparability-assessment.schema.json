      "type": "string"
    },
    "__schema22": {
      "enum": [
        "verified",
        "conditional",
        "rejected"
      ],
      "type": "string"
    },
    "__schema23": {
      "enum": [
        "compatible",
        "conditional",
        "incompatible"
      ],
      "type": "string"
    },
    "__schema24": {
