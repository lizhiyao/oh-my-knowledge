              "verificationFactKind",
              "stage",
              "sourceDigest",
              "verificationAxis",
              "verificationStatus"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "sourceDigest": {
                "$ref": "#/$defs/__schema1"
              },
              "stage": {
                "$ref": "#/$defs/__schema7"
              },
              "trust": {
                "$ref": "#/$defs/__schema14"
              },
              "trustRelation": {
                "$ref": "#/$defs/__schema13"
