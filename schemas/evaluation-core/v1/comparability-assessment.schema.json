        "cache-receipt",
        "invocation-budget",
        "provider-cost-budget",
        "policy-execution"
      ],
      "type": "string"
    },
    "__schema11": {
      "enum": [
        "verified",
        "indeterminate"
      ],
      "type": "string"
    },
    "__schema12": {
      "const": "source-trust",
      "type": "string"
    },
    "__schema13": {
      "enum": [
        "parent",
        "effective"
      ],
      "type": "string"
    },
    "__schema14": {
      "enum": [
        "verified",
        "declared",
        "untrusted",
        "unknown"
